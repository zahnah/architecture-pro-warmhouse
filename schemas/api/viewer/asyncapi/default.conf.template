server {
    listen 8080;
    root /usr/share/nginx/html;

    location = /config.json {
        default_type application/json;
        return 200 '${ASYNCAPI_SPECS}';
    }

    location /specs/ {
        types { text/yaml yaml yml; }
        charset utf-8;
        add_header Cache-Control no-cache;
    }
}

@startuml
!define RELATIVE_INCLUDE

title Warm House — Component Diagram: Platform Service

top to bottom direction

!include C4_Component.puml

Container(gateway, "API Gateway", "Go")
ContainerDb(platformDb, "Platform DB", "PostgreSQL")
ContainerQueue(eventBus, "Event Bus", "Apache Kafka")
ContainerQueue(mqtt, "MQTT Broker", "EMQX")

Container_Boundary(platform, "Platform Service (Go)") {
  Component(identity, "Users & Homes", "Go module", "Регистрация, вход, дома и члены семьи")
  Component(catalog, "Device Catalog", "Go module", "Модели устройств и комплекты; у модели — тип (heating, lighting, ...)")
  Component(onboarding, "Device Onboarding", "Go module", "Привязка устройства к дому по коду и отвязка от дома")
  Component(repo, "Repository", "pgx")
}

Rel(gateway, identity, "gRPC")
Rel(gateway, catalog, "gRPC")
Rel(gateway, onboarding, "gRPC", "AddDevice, RemoveDevice")
Rel(onboarding, catalog, "Тип по модели")
Rel(onboarding, identity, "Проверка дома")
Rel(identity, repo, "")
Rel(catalog, repo, "")
Rel(onboarding, repo, "")
Rel(repo, platformDb, "SQL")
Rel(onboarding, eventBus, "Pub", "device.lifecycle: DeviceRegistered {deviceId, homeId, type}, DeviceUnregistered {deviceId, homeId}")
Rel(onboarding, mqtt, "API", "Выдача и отзыв учётных данных и прав на devices/{id}/*, разрыв сессии")

@enduml
